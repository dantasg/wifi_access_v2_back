[Unit]
Description=AccessWifi: backup do banco (criptografado, enviado ao Telegram)
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/dotnet /opt/accesswifi/ops/AccessWifi.Ops.dll backup
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
