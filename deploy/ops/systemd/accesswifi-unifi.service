[Unit]
Description=AccessWifi: avisa na hora quando a UniFi recusa a liberacao de um cliente
After=network-online.target accesswifi-api.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/dotnet /opt/accesswifi/ops/AccessWifi.Ops.dll seguir-unifi
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
